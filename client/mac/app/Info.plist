<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Virtue</string>
	<key>CFBundleName</key>
	<string>Virtue</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>VirtueBuildLabel</key>
	<string>$(VIRTUE_BUILD_LABEL)</string>
	<key>VirtueReleaseChannel</key>
	<string>$(VIRTUE_RELEASE_CHANNEL)</string>
	<!-- Sparkle. SUFeedURL/SUPublicEDKey are empty unless build-app.sh was run
	     with VIRTUE_ENABLE_AUTO_UPDATE=1; UpdateController treats an empty feed
	     URL as "auto-update disabled" and never starts the updater. The two
	     SU*Automatic* keys below are Sparkle's persisted defaults for a first
	     launch — VirtueUpdateDriver never presents a choice either way, since a
	     dismissible update prompt on a monitoring client is a bypass. -->
	<key>SUFeedURL</key>
	<string>$(VIRTUE_SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(VIRTUE_SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Virtue captures screenshots for accountability monitoring.</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
