# Rust build output
target/
target-docker/

# Cargo registry/home cache used by linux/scripts/build-deb-docker.sh
.docker-cargo-home/

# Backup files generated by rustfmt/rustc tools
**/*.rs.bk

# Cargo-installed binaries in local workspace root (if used)
.cargo/bin/

# Packaged build artifacts
linux/dist/
windows/dist/

# macOS packaged build artifacts
target/macos/
target/**/*.app/
target/**/*.dmg
**/.DS_Store

# Android/Gradle generated and local-only files
android/.gradle/
android/local.properties
android/**/build/
android/.cxx/
android/captures/
android/app/src/main/jniLibs/
android/rust/target/
android/.idea/
android/*.iml
android/*.jks
android/*.keystore
