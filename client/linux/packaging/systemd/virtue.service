[Unit]
Description=Virtue Monitoring Agent
Wants=network-online.target
After=network-online.target graphical-session.target time-sync.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'timedatectl show --property=LocalRTC --value 2>/dev/null | grep -q no && exit 0; echo "virtue: WARNING: RTC is set to local time; waiting for NTP sync" >&2; for i in $(seq 1 30); do timedatectl show --property=NTPSynchronized --value 2>/dev/null | grep -q yes && exit 0; sleep 1; done; exit 0'
ExecStart=/bin/sh -lc 'if [ -z "$${WAYLAND_DISPLAY:-}" ] && [ -z "$${DISPLAY:-}" ]; then for x in /tmp/.X11-unix/X*; do [ -S "$$x" ] || continue; DISPLAY=":$${x##*/X}"; export DISPLAY; break; done; fi; if [ -z "$${XAUTHORITY:-}" ] && [ -f "$$HOME/.Xauthority" ]; then export XAUTHORITY="$$HOME/.Xauthority"; fi; exec /usr/bin/virtue daemon'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
