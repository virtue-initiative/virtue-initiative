#!/bin/sh
set -e

# Runs a shell command as a user without starting a login shell. `su -` would
# source the user's ~/.profile, so one broken line there failed the whole
# install (CLIENT-003). Errors are ignored: setting up one user's service must
# not abort the package install. VIRTUE_RUN_USER_DIR exists for tests only.
run_as_user() {
  run_user="$1"
  run_uid="$2"
  run_cmd="$3"
  run_runtime="${VIRTUE_RUN_USER_DIR:-/run/user}/$run_uid"
  run_home=$(getent passwd "$run_user" 2>/dev/null | cut -d: -f6)
  (
    cd / &&
      runuser -u "$run_user" -- env -i \
        PATH="$PATH" \
        HOME="${run_home:-/}" \
        USER="$run_user" \
        LOGNAME="$run_user" \
        XDG_RUNTIME_DIR="$run_runtime" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=$run_runtime/bus" \
        sh -c "$run_cmd"
  ) >/dev/null 2>&1 || true
}

start_for_user() {
  user="$1"
  uid="$2"

  if [ ! -d "${VIRTUE_RUN_USER_DIR:-/run/user}/$uid" ]; then
    return 0
  fi

  # Ensure user manager sees updated unit content from package upgrade.
  run_as_user "$user" "$uid" "systemctl --user daemon-reload"

  # Legacy cleanup: avoid running both service names at once.
  run_as_user "$user" "$uid" "systemctl --user disable --now virtue.service"

  # Cinnamon uses the xapp-status panel applet as the StatusNotifier host.
  # If it's missing, the daemon can run but the tray icon has nowhere to render.
  if [ -d /usr/share/cinnamon/applets/xapp-status@cinnamon.org ]; then
    run_as_user "$user" "$uid" "applets=\$(gsettings get org.cinnamon enabled-applets 2>/dev/null || true); case \"\$applets\" in *xapp-status@cinnamon.org*) : ;; *) trimmed=\${applets%]}; if [ \"\$trimmed\" != \"\$applets\" ]; then gsettings set org.cinnamon enabled-applets \"\$trimmed, 'panel1:right:1:xapp-status@cinnamon.org:90']\"; fi ;; esac"
  fi

  # Ensure enabled state for this user.
  run_as_user "$user" "$uid" "systemctl --user enable virtue.service"

  # Explicitly restart on upgrades so new binary/unit changes take effect now.
  run_as_user "$user" "$uid" "if systemctl --user is-active --quiet virtue.service; then systemctl --user restart virtue.service; else systemctl --user start virtue.service; fi"
}

start_for_user_once() {
  user="$1"
  uid="$2"
  processed_key=" $uid:$user "

  case " $STARTED_USERS " in
    *"$processed_key"*) return 0 ;;
  esac

  STARTED_USERS="${STARTED_USERS}${processed_key}"
  start_for_user "$user" "$uid"
}

# Enable globally so newly logged-in users auto-start without manual enable.
systemctl --global enable virtue.service >/dev/null 2>&1 || true

# System-level (not --user) timer that periodically checks for and installs
# a newer .deb from GitHub Releases; requires root, unlike virtue.service.
# Only official published-release builds ship with this turned on -- a
# locally-built package (native/Docker build, or a PR's --debug CI build)
# has auto-update-enabled=0 so it never overwrites itself from GitHub.
if [ "$(cat /usr/lib/virtue/auto-update-enabled 2>/dev/null || echo 0)" = "1" ]; then
  systemctl enable --now virtue-update.timer >/dev/null 2>&1 || true
else
  systemctl disable --now virtue-update.timer >/dev/null 2>&1 || true
fi

STARTED_USERS=""

if command -v loginctl >/dev/null 2>&1; then
  while read -r uid user _; do
    [ -n "$uid" ] || continue
    [ -n "$user" ] || continue
    start_for_user_once "$user" "$uid"
  done <<EOF
$(loginctl list-users --no-legend 2>/dev/null || true)
EOF
fi

if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
  uid=$(id -u "$SUDO_USER" 2>/dev/null || true)
  if [ -n "$uid" ]; then
    start_for_user_once "$SUDO_USER" "$uid"
  fi
fi

# Only on a fresh install: on upgrade `configure` gets the old version as $2,
# and the user is already signed in.
if [ "${1:-}" = "configure" ] && [ -z "${2:-}" ]; then
  echo "Virtue is installed. Run \`virtue login\` in a terminal to sign in and start monitoring."
fi

exit 0
