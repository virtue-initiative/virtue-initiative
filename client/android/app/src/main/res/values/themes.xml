<resources>
    <style name="Theme.Bepure" parent="Theme.Material3.Light.NoActionBar">
        <!-- Forest primary -->
        <item name="colorPrimary">@color/virtue_forest</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorPrimaryContainer">@color/bg_subtle</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>

        <!-- Moss secondary -->
        <item name="colorSecondary">@color/virtue_moss</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="colorSecondaryContainer">@color/bg_subtle</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>

        <!-- Backgrounds and surfaces -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/bg_subtle</item>
        <item name="colorOnSurfaceVariant">@color/ink_3</item>
        <item name="colorOutline">@color/border</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
    </style>
</resources>
