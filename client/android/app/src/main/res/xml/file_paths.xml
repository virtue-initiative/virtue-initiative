<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- The daemon's rolling log files, written by client/android/rust's
         init_logging into <filesDir>/core-data/logs. -->
    <files-path
        name="core_logs"
        path="core-data/logs/" />
    <!-- The `.txt` copy the Status Details screen hands to a viewer, so it
         isn't reading a file the daemon is still appending to. -->
    <cache-path
        name="readable_logs"
        path="logs/" />
</paths>
