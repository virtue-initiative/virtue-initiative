{
  "name": "api-donate",
  "version": "1.0.0",
  "description": "Donations API on Cloudflare Workers (Stripe Checkout)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "cf dev --mode staging",
    "deploy:prod": "cf deploy --mode prod",
    "deploy:staging": "cf deploy --mode staging",
    "build": "echo 'No build step needed for Cloudflare Workers -- included in deploy'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.lint.json --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:migrate:local": "bun ../scripts/d1-migrate.ts DB staging src/schema/migrations --local",
    "db:migrate:staging": "bun ../scripts/d1-migrate.ts DB staging src/schema/migrations",
    "db:migrate:prod": "bun ../scripts/d1-migrate.ts DB prod src/schema/migrations",
    "newsletter": "bun scripts/newsletter.ts",
    "import-buttondown": "bun scripts/import-buttondown.ts"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "stripe",
    "donations"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^25.9.9",
    "cf": "1.0.0-beta.27",
    "marked": "^16.4.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "hono": "^4.13.16",
    "stripe": "^22.6.2",
    "zod": "^4.6.7"
  }
}
