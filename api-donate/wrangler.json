{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtueinitiative-donate-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "dev": {
    "port": 8788
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "virtueinitiative-donate-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "src/schema/migrations"
    }
  ],
  "vars": {
    "LANDING_URL": "https://virtueinitiative.org"
  },
  "routes": [
    {
      "pattern": "donate-api.virtueinitiative.org/*",
      "zone_name": "virtueinitiative.org"
    }
  ]
}
