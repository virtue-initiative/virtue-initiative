[Unit]
Description=virtue-hash (production)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/virtue-hash
EnvironmentFile=/home/ubuntu/virtue-hash/.env
ExecStart=/home/ubuntu/virtue-hash/virtue-hash
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
