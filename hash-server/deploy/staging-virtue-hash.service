[Unit]
Description=staging-virtue-hash
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/staging-virtue-hash
EnvironmentFile=/home/ubuntu/staging-virtue-hash/.env
ExecStart=/home/ubuntu/staging-virtue-hash/staging-virtue-hash
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
