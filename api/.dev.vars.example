# .dev.vars template
# Copy this file to .dev.vars and fill in the values

# JWT signing keypair. Use an Ed25519 PKCS#8 private key and matching SPKI public key.
# Values can be literal PEM blocks or "\n"-escaped PEM strings.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIICDMV++otdvtyN120jSEqOU7u5a119/aSvUSuh26V61\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAbYBZuUYl4eRF+lRwOKOk6fgjK2OA7CSA7EZSWtHeN9I=\n-----END PUBLIC KEY-----"

# Web app URL. Its origin is also used for CORS.
APP_URL=http://localhost:5173

# App name used in outbound emails.
APP_NAME=Virtue Initiative

# Optional path prefix that the worker should also accept.
# Example: /api makes both https://api.example.com/login and https://example.com/api/login work.
API_BASE_PATH=/api

# Public base URL for R2 batch blobs
R2_URL=http://localhost:8787/r2

# Base URL of the standalone hash-server (see ../hash-server/), which must be running
# separately — this API only talks to it as a client (see lib/hash-server.ts and
# hash-server/SPEC.md). It must share the JWT_PUBLIC_KEY above as its own JWT_PUBLIC_KEY.
HASH_SERVER_URL=http://localhost:8788

# Can be changed to SES
EMAIL_DELIVERY_MODE=log

# Where POST /bug-report emails get sent
BUG_REPORT_EMAIL=help@virtueinitiative.org

# AWS credentials for SES
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
