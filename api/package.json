{
  "name": "api",
  "version": "1.0.0",
  "description": "Screenshot accountability API on Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "cf dev --mode staging",
    "deploy:prod": "cf deploy --mode prod",
    "deploy:staging": "cf deploy --mode staging",
    "build": "echo 'No build step needed for Cloudflare Workers -- included in deploy'",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.lint.json --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "db:clean:local": "rm -rf ./.wrangler/state/v3/d1 && rm -rf ./.wrangler/state/v3/r2",
    "db:clean:prod": "node scripts/clean-remote.mjs prod",
    "db:clean:staging": "node scripts/clean-remote.mjs staging",
    "db:migrate:local": "bun ../scripts/d1-migrate.ts DB staging src/schema/migrations --local && bun ../scripts/d1-migrate.ts DONATE_DB staging ../api-donate/src/schema/migrations --local",
    "db:migrate:staging": "bun ../scripts/d1-migrate.ts DB staging src/schema/migrations",
    "db:migrate:prod": "bun ../scripts/d1-migrate.ts DB prod src/schema/migrations"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^25.9.9",
    "@types/uuid": "^10.0.0",
    "cf": "1.0.0-beta.27",
    "fast-check": "^4.10.2",
    "hono": "^4.13.16",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sesv2": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@hono/node-server": "^1.19.18",
    "@hono/zod-validator": "^0.7.6",
    "@msgpack/msgpack": "^3.1.3",
    "@noble/hashes": "^2.4.0",
    "jose": "^6.2.15",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  }
}
