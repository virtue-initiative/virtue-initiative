{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "dev": {
    "port": 8787
  },
  "triggers": {
    "crons": ["5 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "env": {
    "prod": {
      "name": "api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "app-db",
          "database_id": "141a161a-a16b-41cb-a8b3-e5e40803391a",
          "migrations_dir": "src/schema/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "app-bucket"
        }
      ],
      "vars": {
        "JWT_ACCESS_EXPIRY": "15m",
        "JWT_REFRESH_EXPIRY": "7d",
        "API_BASE_PATH": "/api",
        "R2_URL": "https://r2.virtueinitiative.org",
        "APP_URL": "https://app.virtueinitiative.org",
        "APP_NAME": "Virtue Initiative",
        "AWS_SES_REGION": "us-east-1",
        "AWS_SES_FROM_EMAIL": "notifications@virtueinitiative.org",
        "EMAIL_DELIVERY_MODE": "ses",
        "HASH_SERVER_URL": "https://app.virtueinitiative.org/api"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "routes": [
        {
          "pattern": "api.virtueinitiative.org/*",
          "zone_name": "virtueinitiative.org"
        },
        {
          "pattern": "app.virtueinitiative.org/api/*",
          "zone_name": "virtueinitiative.org"
        }
      ]
    },
    "staging": {
      "name": "staging-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "staging-app-db",
          "database_id": "f00a68e9-9ca0-4fa9-98e9-c135a489df3f",
          "migrations_dir": "src/schema/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "staging-app-bucket"
        }
      ],
      "vars": {
        "JWT_ACCESS_EXPIRY": "15m",
        "JWT_REFRESH_EXPIRY": "7d",
        "API_BASE_PATH": "/api",
        "R2_URL": "https://staging.r2.virtueinitiative.org",
        "APP_URL": "https://staging.app.virtueinitiative.org",
        "APP_NAME": "Virtue Initiative",
        "AWS_SES_REGION": "us-east-1",
        "AWS_SES_FROM_EMAIL": "notifications@virtueinitiative.org",
        "EMAIL_DELIVERY_MODE": "ses",
        "HASH_SERVER_URL": "https://staging.app.virtueinitiative.org/api"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "routes": [
        {
          "pattern": "staging.app.virtueinitiative.org/api/*",
          "zone_name": "virtueinitiative.org"
        }
      ]
    }
  }
}
