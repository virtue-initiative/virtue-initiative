---
import { Button } from '@virtueinitiative/shared-web';
import { APP_URL } from '../lib/app-url';

interface Props {
  tagline?: string;
}

const { tagline } = Astro.props;
---

<header class="site-header-shell">
  <div class="site-container">
    <div class="site-header-top">
      <div class="site-header-copy">
        <a href="/" class="site-wordmark">The Virtue Initiative</a>
        {tagline && <p class="site-tagline">{tagline}</p>}
      </div>
      <div class="site-header-actions">
        <button class="vi-icon-btn" id="theme-toggle" aria-label="Toggle dark mode"></button>
        <Button href={APP_URL} variant="primary">Login / Sign up</Button>
      </div>
    </div>
  </div>
</header>
