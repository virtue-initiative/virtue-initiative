---
import { APP_URL } from "../lib/app-url";

interface Props {
  tagline?: string;
}

const { tagline } = Astro.props;
---

<header class="site-header-shell">
  <div class="site-container">
    <div class="site-header-top">
      <div class="site-header-copy">
        <a href="/" class="site-wordmark">The Virtue Initiative</a>
        {tagline && <p class="site-tagline">{tagline}</p>}
      </div>
      <div class="site-header-actions">
        <button
          class="control control-icon"
          id="theme-toggle"
          aria-label="Toggle dark mode"></button>
        <a href={APP_URL} class="btn btn-primary"> Login / Sign up </a>
      </div>
    </div>
  </div>
</header>
