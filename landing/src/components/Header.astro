---
import { Button } from '@virtueinitiative/shared-web';
import { APP_URL } from '../lib/app-url';
import RightArrowIcon from './icons/RightArrowIcon.astro';

interface Props {
  tagline?: string;
}

const { tagline } = Astro.props;
---

<header class="site-header-shell">
  <div class="site-container">
    <div class="site-header">
      <div class="site-header-copy">
        <a href="/" class="site-wordmark">The Virtue Initiative</a>
        {tagline && <p class="site-tagline eyebrow">{tagline}</p>}
      </div>
      <div class="site-header-actions">
        <Button href="/donate" variant="outline">Donate</Button>
        <Button href={APP_URL}
          ><div class="site-header-text-icon-button-container">
            <div>Sign in</div><RightArrowIcon />
          </div></Button
        >
      </div>
    </div>
  </div>
</header>
