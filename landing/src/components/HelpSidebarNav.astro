---
import type { HelpNavItem } from '../help/navigation';

interface Props {
  currentPath: string;
  rootLinks: HelpNavItem[];
}

const { currentPath, rootLinks } = Astro.props;

function sectionContainsPath(item: HelpNavItem, pathname: string): boolean {
  if (item.href === pathname) {
    return true;
  }

  return item.items?.some((child) => sectionContainsPath(child, pathname)) ?? false;
}
---

<ul class="help-sidebar-list">
  {
    rootLinks.map((item) => (
      <li>
        {item.items && item.items.length > 0 ? (
          <details class="help-sidebar-section" open={sectionContainsPath(item, currentPath)}>
            <summary
              class:list={[
                'help-sidebar-section-summary',
                { 'is-active': item.href === currentPath },
              ]}
            >
              {item.href && (
                <a
                  href={item.href}
                  class:list={['help-sidebar-item', { 'is-active': item.href === currentPath }]}
                >
                  {item.label}
                </a>
              )}
              <span class="help-sidebar-toggle" aria-hidden="true" />
            </summary>
            <ul class="help-sidebar-sublist">
              {item.items.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class:list={[
                      'help-sidebar-item',
                      'help-sidebar-item-child',
                      { 'is-active': child.href === currentPath },
                    ]}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          item.href && (
            <a
              href={item.href}
              class:list={['help-sidebar-item', { 'is-active': item.href === currentPath }]}
            >
              {item.label}
            </a>
          )
        )}
      </li>
    ))
  }
</ul>
