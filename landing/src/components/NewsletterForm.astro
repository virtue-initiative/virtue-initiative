---
import { Button, Input } from '@virtueinitiative/shared-web';
import { DONATE_API_URL, TURNSTILE_SITE_KEY } from '../lib/donate-url';

// Posts to the donate worker, which records the visitor's region and emails them a confirmation
// link. The address only receives newsletters once they click it, which is what makes this safe
// to accept from anyone. Accounts opt in from the signup form instead (API-010).
const NEWSLETTER_URL = `${DONATE_API_URL}/newsletter`;

interface Props {
  centered?: boolean;
}
const { centered = false } = Astro.props;
---

<section
  id="newsletter"
  class:list={['newsletter', { 'newsletter-centered': centered }]}
  aria-labelledby="newsletter-heading"
>
  <div class="eyebrow">Newsletter</div>
  <h2 id="newsletter-heading">Get project updates</h2>
  <p>
    We send occasional news about the project, new features, and new articles. You do not need a
    Virtue account to subscribe.
  </p>
  <form class="newsletter-form" action={NEWSLETTER_URL} method="post">
    <label class="newsletter-label" for="newsletter-email">Email address</label>
    <div class="newsletter-row">
      <Input
        id="newsletter-email"
        name="email"
        type="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <Button type="submit" variant="primary">Subscribe</Button>
    </div>
    {
      TURNSTILE_SITE_KEY && (
        <div
          class="cf-turnstile"
          data-sitekey={TURNSTILE_SITE_KEY}
          data-action="newsletter"
          data-appearance="interaction-only"
        />
      )
    }
  </form>
  {
    TURNSTILE_SITE_KEY && (
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
    )
  }
  <p class="newsletter-fine-print">
    We will email you a link to confirm first. We never share your address. Cloudflare Turnstile
    checks that you are a person. See our <a href="/privacy">Privacy Policy</a>.
  </p>
</section>
