---
import { Button, Input } from '@virtueinitiative/shared-web';
import { API_URL } from '../lib/api-url';

// A plain form post to the API (API-058), which redirects back to /newsletter/subscribed or
// /newsletter/error. The Turnstile widget adds its token as the `cf-turnstile-response` field.
// Accounts opt in from the signup form instead (API-010).
const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

interface Props {
  centered?: boolean;
}
const { centered = false } = Astro.props;
---

<section
  class:list={['newsletter', { 'newsletter-centered': centered }]}
  aria-labelledby="newsletter-heading"
>
  <div class="eyebrow">Newsletter</div>
  <h2 id="newsletter-heading">Get project updates</h2>
  <p>
    We send occasional news about the project, new features, and new articles. You do not need a
    Virtue account to subscribe.
  </p>
  <form class="newsletter-form" action={`${API_URL}/newsletter`} method="post">
    <label class="newsletter-label" for="newsletter-email">Email address</label>
    <div class="newsletter-row">
      <Input
        id="newsletter-email"
        name="email"
        type="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
      />
      <Button type="submit" variant="primary">Subscribe</Button>
    </div>
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
  </form>
  <p class="newsletter-fine-print">
    We never share your address. See our <a href="/privacy">Privacy Policy</a>.
  </p>
</section>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
