---
import { DonateForm } from '../components/DonateForm';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout pageTitle="Donate" tagline="Support free accountability tools for everyone">
  <div class="donate-notices">
    <div class="donate-tax-notice">
      <strong>Please note:</strong> The Virtue Initiative is working toward 501(c)(3) status, but we are
      not there yet. Donations are <strong>not currently tax deductible</strong>.
    </div>
    <div class="donate-tax-notice">
      <strong>Please note:</strong> We are currently only able to accept donations from New York residents.
      If you are not a New York resident and have questions about the app or supporting our work, please
      reach out to <a href="mailto:help@virtueinitiative.org">help@virtueinitiative.org</a>.
    </div>
  </div>

  <section class="donate-layout">
    <div class="donate-intro">
      <h2>Support the mission</h2>
      <p>
        The Virtue Initiative builds free tools and resources to help people break free from
        pornography. We fundraise all of our support so the app can stay free forever. Your gift
        keeps it that way.
      </p>
      <p class="donate-intro-note">
        Please note: donations are not currently tax deductible, as we are still working toward
        501(c)(3) status.
      </p>
    </div>

    <div class="donate-card">
      <DonateForm client:load />
    </div>
  </section>
</SiteLayout>
