---
import { Button } from '@virtueinitiative/shared-web';
import SiteLayout from '../../layouts/SiteLayout.astro';

// POST /newsletter/unsubscribe (API-060) redirects here.
---

<SiteLayout pageTitle="Unsubscribed">
  <section class="newsletter-status">
    <h2>You are unsubscribed</h2>
    <p>We will not send you any more newsletters.</p>
    <div class="newsletter-status-actions">
      <Button href="/" variant="primary">Back to home</Button>
    </div>
  </section>
</SiteLayout>
