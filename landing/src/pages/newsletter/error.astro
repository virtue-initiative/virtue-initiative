---
import { Button } from '@virtueinitiative/shared-web';
import SiteLayout from '../../layouts/SiteLayout.astro';

// The newsletter endpoints (API-058 to API-060) redirect here when a form post fails: an invalid
// email, a failed Turnstile check, or a link whose token is unknown.
---

<SiteLayout pageTitle="Newsletter error">
  <section class="newsletter-status">
    <h2>That did not work</h2>
    <p>
      If you were subscribing, check that your email address is correct, wait for the verification
      check to finish, and try again. If you followed a link from one of our emails, it is no longer
      valid.
    </p>
    <p class="newsletter-status-note">
      If it keeps failing, email <a href="mailto:help@virtueinitiative.org"
        >help@virtueinitiative.org</a
      >.
    </p>
    <div class="newsletter-status-actions">
      <Button href="/blog" variant="primary">Back to the blog</Button>
      <Button href="/" variant="outline">Back to home</Button>
    </div>
  </section>
</SiteLayout>
