---
import { Button } from '@virtueinitiative/shared-web';
import SiteLayout from '../../layouts/SiteLayout.astro';

// The donate worker redirects here after NewsletterForm is submitted. They aren't subscribed
// yet, because they still need to click the link in the confirmation email.
---

<SiteLayout pageTitle="Check your email">
  <section class="newsletter-status">
    <h2>Check your email</h2>
    <p>
      We sent you a link to confirm your subscription. Click it to start getting project updates.
    </p>
    <p class="newsletter-status-note">
      If it does not arrive in a few minutes, check your spam folder.
    </p>
    <div class="newsletter-status-actions">
      <Button href="/" variant="primary">Back to home</Button>
      <Button href="/blog" variant="outline">Read the blog</Button>
    </div>
  </section>
</SiteLayout>
