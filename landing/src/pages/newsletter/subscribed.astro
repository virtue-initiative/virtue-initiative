---
import { Button } from '@virtueinitiative/shared-web';
import SiteLayout from '../../layouts/SiteLayout.astro';

// POST /newsletter (API-058) redirects here after NewsletterForm subscribes an address.
---

<SiteLayout pageTitle="Subscribed">
  <section class="newsletter-status">
    <h2>You are subscribed</h2>
    <p>
      Thanks for signing up. We will email you occasional news about the project, new features, and
      new articles.
    </p>
    <div class="newsletter-status-actions">
      <Button href="/" variant="primary">Back to home</Button>
      <Button href="/blog" variant="outline">Read the blog</Button>
    </div>
  </section>
</SiteLayout>
