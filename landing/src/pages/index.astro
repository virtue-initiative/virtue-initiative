---
import { getCollection } from 'astro:content';
import { Button } from '@virtueinitiative/shared-web';
import CheckIcon from '../components/icons/CheckIcon.astro';
import MinusIcon from '../components/icons/MinusIcon.astro';
import LogoMark from '../components/LogoMark.astro';
import RightArrowIcon from '../components/icons/RightArrowIcon.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { APP_URL } from '../lib/app-url';

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<SiteLayout tagline="Est. 2026">
  <div class="home-page">
    <section class="home-hero">
      <div class="home-hero-copy">
        <div class="eyebrow">A non-profit accountability project</div>
        <h1>We want to see a world set free from pornography.</h1>
        <p class="home-hero-lead">
          Virtue is a simple app that shares blurred screenshots of your activity with an
          accountability partner you trust. It's entirely free to use and end-to-end encrypted.
        </p>
        <div class="section-actions">
          <Button href={`${APP_URL}/signup`} variant="primary" size="lg">
            <div class="home-text-icon-button-container">
              <div>Get started</div><RightArrowIcon />
            </div>
          </Button>
          <Button href="/about" size="lg">Read our mission</Button>
          <Button href="/help" size="lg">Help and guides</Button>
        </div>
      </div>
      <div class="home-hero-logo" aria-hidden="true">
        <LogoMark />
      </div>
    </section>

    <section class="home-section">
      <div class="eyebrow">The app</div>
      <div class="home-section-heading">
        <h2>How it works</h2>
      </div>
      <ol class="steps-grid">
        <li class="step-card">
          <span class="step-number">1.</span>
          <span>Create an account</span>
        </li>
        <li class="step-card">
          <span class="step-number">2.</span>
          <span>Install the app on your devices</span>
        </li>
        <li class="step-card">
          <span class="step-number">3.</span>
          <span>It captures blurred screenshots of your activity</span>
        </li>
        <li class="step-card">
          <span class="step-number">4.</span>
          <span>Your accountability partner can review them</span>
        </li>
      </ol>
    </section>

    <section class="home-section home-section-split">
      <div class="home-section-body">
        <div class="partner-copy">
          <div class="eyebrow">Your support</div>
          <div class="home-section-heading">
            <h2>You need one accountability partner</h2>
          </div>

          <p>This only works if someone else can see your activity.</p>
          <p>That could be:</p>
          <div class="home-row-with-spacing">
            <RightArrowIcon /><div>a friend</div>
          </div>
          <div class="home-row-with-spacing">
            <RightArrowIcon /><div>a brother</div>
          </div>
          <div class="home-row-with-spacing">
            <RightArrowIcon /><div>a mentor</div>
          </div>
          <div class="home-row-with-spacing">
            <RightArrowIcon /><div>your father</div>
          </div>
          <p>
            Once you make an account, invite someone by email to be your accountability partner.
          </p>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="vi-card privacy-card">
        <div class="home-section-heading">
          <h2>Privacy &amp; security</h2>
        </div>
        <div class="home-row-with-spacing">
          <RightArrowIcon /><div>Screenshots are shrunk and blurred before being shared</div>
        </div>
        <div class="home-row-with-spacing">
          <RightArrowIcon /><div>Data is end-to-end encrypted</div>
        </div>
        <div class="home-row-with-spacing">
          <RightArrowIcon /><div>
            Only your chosen accountability partner can view your activity
          </div>
        </div>
        <div class="home-row-with-spacing">
          <RightArrowIcon /><div>No ads or data selling</div>
        </div>
      </div>
    </section>

    <section class="home-section">
      <div class="eyebrow">Answers</div>
      <div class="home-section-heading">
        <h2>FAQ</h2>
      </div>

      <div class="faq-list">
        <details class="faq-item" open>
          <summary>What does the app share?</summary>
          <p>
            It captures blurred screenshots of activity on supported devices and makes them
            available to the accountability partner you choose.
          </p>
        </details>

        <details class="faq-item" open>
          <summary>Do I need an accountability partner before I start?</summary>
          <p>
            Yes. This only works if one other person can review your activity. Start with one person
            you trust.
          </p>
        </details>

        <details class="faq-item">
          <summary>Is it really free?</summary>
          <p>
            Yes. The app is free to use with no subscriptions. Our code is even <a
              href="https://github.com/virtue-initiative">open source</a
            >.
          </p>
        </details>

        <details class="faq-item">
          <summary>Who can see my data?</summary>
          <p>
            Only the accountability partner you authorize can review it. The data is end-to-end
            encrypted, and the service does not sell it or use it for ads.
          </p>
        </details>

        <details class="faq-item">
          <summary>How do I install it?</summary>
          <p>
            You can install Virtue on supported devices from the
            <a href="/download">downloads page</a>, and the
            <a href="/help/getting-started">getting started guide</a> walks through the setup.
          </p>
        </details>
      </div>
    </section>

    <section class="home-section" id="platforms">
      <div class="eyebrow">Features</div>
      <div class="home-section-heading">
        <h2>Currently supported platforms &amp; features</h2>
      </div>
      <p>
        We are working hard to support more platforms and features. Below is the current feature
        support by platform. This is still a beta stage project.
      </p>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Feature</th>
              <th>Windows</th>
              <th>macOS</th>
              <th>Linux</th>
              <th>
                Android<sup><a href="#platform-footnote-1">1</a></sup>
              </th>
              <th>iOS<sup><a href="#platform-footnote-2">2</a></sup></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Periodic screenshots</td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
            <tr>
              <td>Detects shutdowns</td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
            <tr>
              <td>End-to-end encryption</td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
            <tr>
              <td>Daily/weekly email reports</td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="yes"><CheckIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
            <tr>
              <td>Immediate email alerts</td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
            <tr>
              <td>Detects tampering</td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
            <tr>
              <td>Captures web history</td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
            <tr>
              <td>Image risk classification</td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
              <td class="no"><MinusIcon /></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="table-footnotes">
        <p id="platform-footnote-1">
          <sup>1</sup> Android currently requires sideloading the app.
        </p>
        <p id="platform-footnote-2">
          <sup>2</sup> iOS Safari monitoring coming soon.
        </p>
      </div>
    </section>

    {
      latestPosts.length > 0 && (
        <section class="home-section">
          <div class="eyebrow">Articles</div>
          <div class="home-section-heading">
            <h2>From the blog</h2>
          </div>
          <ul class="home-blog-list">
            {latestPosts.map((post) => (
              <li class="home-blog-item">
                <a href={`/blog/${post.id}`} class="home-blog-item-title">
                  {post.data.title}
                </a>
                <span class="home-blog-item-meta">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                  {post.data.author && <> · {post.data.author}</>}
                </span>
              </li>
            ))}
          </ul>
          <div class="section-actions">
            <Button href="/blog" variant="outline" size="lg">
              View all posts
            </Button>
          </div>
        </section>
      )
    }

    <section class="home-section home-cta">
      <div class="home-section-heading">
        <h2>Get started</h2>
      </div>
      <p>Create your account and set up your accountability partner.</p>
      <div class="section-actions">
        <Button href={`${APP_URL}/signup`} variant="primary" size="lg">Get started</Button>
      </div>
    </section>
  </div>
</SiteLayout>
