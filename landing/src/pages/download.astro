---
import type { MarkdownInstance } from 'astro';
import { Button } from '@virtueinitiative/shared-web';
import { applyAppLinks } from '../lib/app-url';
import LaptopIcon from '../components/icons/LaptopIcon.astro';
import MobileIcon from '../components/icons/MobileIcon.astro';
import releaseData from '../data/releases.json';
import SiteLayout from '../layouts/SiteLayout.astro';

type ReleaseAsset = {
  name: string;
  browser_download_url: string;
};

type Release = {
  name: string | null;
  tag_name: string;
  html_url: string;
  published_at: string | null;
  latest_asset_at?: string | null;
  assets: ReleaseAsset[];
};

type Platform = {
  label: string;
  detail: string;
  kind: 'laptop' | 'mobile';
  preferredMatches?: (assetName: string) => boolean;
  fallbackMatches?: (assetName: string) => boolean;
  staticHref?: string;
  // Slug of the matching file in src/content/download-instructions/ and the
  // anchor id of its section further down the page.
  instructionsSlug: string;
};

const platforms: Platform[] = [
  {
    label: 'Windows',
    detail: 'Microsoft Store',
    kind: 'laptop',
    instructionsSlug: 'windows',
    staticHref: 'https://apps.microsoft.com/detail/9PHQ4Z8445DQ',
  },
  {
    label: 'macOS',
    detail: '.dmg installer',
    kind: 'laptop',
    instructionsSlug: 'mac',
    fallbackMatches: (assetName) =>
      /\.dmg$/i.test(assetName) &&
      (/^virtue-macos-/i.test(assetName) || /^Virtue-/i.test(assetName)),
  },
  {
    label: 'Linux',
    detail: '.deb package',
    kind: 'laptop',
    instructionsSlug: 'linux',
    preferredMatches: (assetName) => /^virtue-linux_/i.test(assetName),
    fallbackMatches: (assetName) =>
      /\.deb$/i.test(assetName) &&
      (/^virtue-linux_/i.test(assetName) || /^virtue_/i.test(assetName)),
  },
  {
    label: 'Android',
    detail: '.apk package',
    kind: 'mobile',
    instructionsSlug: 'android',
    fallbackMatches: (assetName) => /\.apk$/i.test(assetName) && /android/i.test(assetName),
  },
  {
    label: 'iOS',
    detail: 'TestFlight beta',
    kind: 'mobile',
    instructionsSlug: 'ios',
    staticHref: 'https://testflight.apple.com/join/RCcmnCd5',
  },
];

function formatDate(value: string | null) {
  if (!value) return 'Unpublished';

  return new Intl.DateTimeFormat('en-US', {
    dateStyle: 'medium',
    timeStyle: 'short',
  }).format(new Date(value));
}

function findPlatformAsset(release: Release, platform: Platform) {
  if (platform.preferredMatches) {
    const preferred = release.assets.find((asset) => platform.preferredMatches?.(asset.name));
    if (preferred) return preferred;
  }

  return release.assets.find((asset) => platform.fallbackMatches?.(asset.name)) ?? null;
}

function findPlatformHref(release: Release | null, platform: Platform) {
  if (platform.staticHref) return platform.staticHref;
  return release ? (findPlatformAsset(release, platform)?.browser_download_url ?? null) : null;
}

const stableRelease = releaseData.stableRelease as Release | null;
const prereleaseRelease = releaseData.prereleaseRelease as Release | null;

// Staging deploys (`astro build --mode staging`) surface development builds
// instead of the stable release, mirroring NoindexMeta.astro / CanonicalLink.astro.
const isStaging = import.meta.env.MODE === 'staging';
const activeRelease = isStaging ? prereleaseRelease : stableRelease;

// Platform install docs live in src/content/download-instructions/*.md and can
// reference the current download link for their platform via {LINUX_DOWNLOAD},
// {MAC_DOWNLOAD}, {WINDOWS_DOWNLOAD}, {ANDROID_DOWNLOAD}, {IOS_DOWNLOAD} —
// substituted into the compiled HTML below since Astro compiles markdown before
// this file runs.
const downloadVarTokens: Record<string, string> = {
  linux: '{LINUX_DOWNLOAD}',
  mac: '{MAC_DOWNLOAD}',
  windows: '{WINDOWS_DOWNLOAD}',
  android: '{ANDROID_DOWNLOAD}',
  ios: '{IOS_DOWNLOAD}',
};

function applyDownloadVars(html: string) {
  return platforms.reduce((acc, platform) => {
    const token = downloadVarTokens[platform.instructionsSlug];
    if (!token) return acc;
    const href = findPlatformHref(activeRelease, platform) ?? '/download';
    // Markdown link syntax puts the token in an href="...", so the compiled
    // HTML has it percent-encoded (e.g. `{` -> `%7B`) — replace both forms.
    return acc.replaceAll(token, href).replaceAll(encodeURI(token), href);
  }, html);
}

// All 5 platform docs now render on this one page, so their auto-generated
// heading ids (e.g. "## Installation" -> id="installation") would otherwise
// collide across panels — invalid duplicate ids and a broken #installation
// target. Namespace every heading id to the platform's slug.
function namespaceHeadingIds(html: string, slug: string) {
  return html.replace(/(<h[1-6][^>]*\sid=")([^"]+)(")/g, `$1${slug}-$2$3`);
}

const instructionModules = import.meta.glob('../content/download-instructions/*.md', {
  eager: true,
}) as Record<string, MarkdownInstance<Record<string, never>>>;

const instructionSections = await Promise.all(
  platforms.map(async (platform) => {
    const entry =
      instructionModules[`../content/download-instructions/${platform.instructionsSlug}.md`];
    const html = entry
      ? namespaceHeadingIds(
          applyAppLinks(applyDownloadVars(await entry.compiledContent())),
          platform.instructionsSlug,
        )
      : null;
    return { platform, html };
  }),
);
---

<SiteLayout pageTitle="Downloads" tagline="Download Virtue for your devices">
  <div class="dev-warning-banner">
    <strong>Warning:</strong> Virtue is currently in early development and does not work reliably. Downloads
    are provided for testing purposes only.
  </div>

  <section>
    <h2>Downloads - {isStaging ? 'Latest development release' : 'Latest stable release'}</h2>
    <div class="release-card">
      {
        activeRelease ? (
          <>
            <div class="release-card-header">
              <div>
                <h3>{activeRelease.name || activeRelease.tag_name}</h3>
              </div>
              <Button variant="ghost" size="sm" href={activeRelease.html_url}>
                View on GitHub
              </Button>
            </div>
            <div class="release-card-meta">
              <span>Tag: {activeRelease.tag_name}</span>
              <span>Published: {formatDate(activeRelease.published_at)}</span>
            </div>
            <div class="release-card-body">
              <div class="download-grid">
                {platforms.map((platform) => {
                  const Icon = platform.kind === 'laptop' ? LaptopIcon : MobileIcon;

                  const href = findPlatformHref(activeRelease, platform);

                  return href ? (
                    <a class="vi-btn vi-btn--outline text-icon download-button" href={href}>
                      <span class="icon">
                        <Icon />
                      </span>
                      <span class="download-button-content">
                        <span class="download-button-label">{platform.label}</span>
                        <span class="download-button-detail">{platform.detail}</span>
                      </span>
                    </a>
                  ) : (
                    <span
                      class="vi-btn vi-btn--ghost text-icon download-button-unavailable"
                      aria-disabled="true"
                    >
                      <span class="icon">
                        <Icon />
                      </span>
                      <span class="download-button-content">
                        <span class="download-button-label">{platform.label}</span>
                        <span class="download-button-detail">{platform.detail}</span>
                      </span>
                    </span>
                  );
                })}
              </div>
            </div>

            <div class="instructions">
              <h4 class="instructions-heading">Installation instructions</h4>
              <div class="instructions-tabs">
                {instructionSections.map(({ platform }) => (
                  <a href={`#${platform.instructionsSlug}`} class="instructions-tab-label">
                    {platform.label}
                  </a>
                ))}
                {instructionSections.map(
                  ({ platform, html }) =>
                    html && (
                      <div id={platform.instructionsSlug} class="instructions-tab-panel help-doc">
                        <Fragment set:html={html} />
                      </div>
                    ),
                )}
              </div>
            </div>
          </>
        ) : (
          <div class="release-card-body">
            <p>Coming soon.</p>
          </div>
        )
      }
    </div>
  </section>
</SiteLayout>
