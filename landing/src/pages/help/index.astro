---
import HelpSearch from '../../components/HelpSearch.astro';
import HelpLayout from '../../layouts/HelpLayout.astro';
import { helpTopics, topicHref, topicLinks } from '../../help/navigation';
---

<HelpLayout
  currentPath="/help"
  pageTitle="Help and Setup Guides"
  description="Guides for installing Virtue, setting up an accountability partner, and reviewing activity."
  wide
>
  <div class="help-home">
    <header class="help-home-hero">
      <h1>How can we help?</h1>
      <HelpSearch large />
    </header>
    <ul class="help-topic-cards">
      {
        helpTopics.map((topic) => (
          <li>
            <a class="help-topic-card" href={topicHref(topic.id)}>
              <span class="help-topic-card-title">{topic.label}</span>
              <span class="help-topic-card-blurb">{topic.blurb}</span>
              <span class="help-topic-card-count">
                {topicLinks(topic.id).length === 1
                  ? '1 article'
                  : `${topicLinks(topic.id).length} articles`}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</HelpLayout>
