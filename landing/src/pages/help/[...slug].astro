---
import HelpLayout from '../../layouts/HelpLayout.astro';
import { helpArticles, helpTopics, topicHref } from '../../help/navigation';
import { rewriteAppLinks } from '../../lib/app-url';

export function getStaticPaths() {
  return helpArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const topic = helpTopics.find((t) => t.id === article.topic)!;
const { module } = article;
const contentHtml = module.compiledContent ? rewriteAppLinks(await module.compiledContent()) : null;
const EntryContent = module.Content;
---

<HelpLayout currentPath={article.href} pageTitle={article.title} description={article.description}>
  <article class="help-content-card help-doc" data-pagefind-body>
    <a class="help-breadcrumb" href={topicHref(topic.id)} data-pagefind-ignore>{topic.label}</a>
    <h1>{article.title}</h1>
    {contentHtml ? <Fragment set:html={contentHtml} /> : <EntryContent />}
  </article>
</HelpLayout>
