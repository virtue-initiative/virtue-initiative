{
  "name": "landing",
  "version": "1.0.0",
  "description": "Astro landing site for virtueinitiative.org.",
  "scripts": {
    "predev": "bun run sync-release-data",
    "dev": "astro dev",
    "sync-release-data": "bun ./scripts/fetch-release-data.mjs",
    "prepare-release-data": "bun ./scripts/prepare-release-data.mjs",
    "pretypecheck": "bun run prepare-release-data",
    "typecheck": "astro check",
    "prebuild": "bun run prepare-release-data && bun run build-appcast",
    "build": "astro build",
    "format": "prettier --plugin prettier-plugin-astro --write .",
    "format:check": "prettier --plugin prettier-plugin-astro --check .",
    "deploy:prod": "bun run build && wrangler deploy --env prod",
    "deploy:staging": "bun run prepare-release-data && bun run build-appcast && astro build --mode staging && wrangler deploy --env staging",
    "preview": "astro preview",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-appcast": "bun ./scripts/build-appcast.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "dependencies": {
    "@astrojs/mdx": "7.0.2",
    "@astrojs/preact": "6.0.1",
    "@virtueinitiative/shared-web": "file:../shared-web",
    "astro": "7.0.6",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.16.0",
    "preact": "^10.29.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.70.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.59.0"
  }
}
