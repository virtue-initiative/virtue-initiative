PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
PUBLIC_DONATE_API_URL=http://localhost:8788
# Stripe-hosted Customer Portal login URL (billing.stripe.com/p/login/...). Leave blank to hide the "Manage donations" button.
PUBLIC_STRIPE_PORTAL_URL=
# Cloudflare Turnstile's test site key, which always passes. Goes with the test secret in api/.dev.vars.example.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
