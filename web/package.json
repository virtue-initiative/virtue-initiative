{
  "private": true,
  "name": "@virtueinitiative/web",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.lint.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:prod": "bun run build && cf-wrangler build --mode prod && cf deploy --prebuilt --mode prod",
    "deploy:staging": "vite build --mode staging && cf-wrangler build --mode staging && cf deploy --prebuilt --mode staging"
  },
  "dependencies": {
    "@hpke/core": "^1.10.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@msgpack/msgpack": "^3.1.3",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tanstack/react-virtual": "^3.14.26",
    "@virtueinitiative/shared-web": "workspace:*",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.7",
    "hash-wasm": "^4.12.0",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.8.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.8",
    "cf": "1.0.0-beta.27",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.6",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wrangler": "^4.157.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-x64": "^4.67.5"
  }
}
