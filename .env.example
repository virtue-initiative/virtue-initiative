# Copy to .env (repo root, gitignored) for per-worktree overrides. Values here
# win over ~/.config/virtue-dev.env (the machine-wide layer — see AGENTS.md),
# which in turn only fills in whatever isn't set here. Real process/CI env vars
# always take precedence over both files. Read as shell, so use KEY=value.
#
# Everything below is optional — only set what you actually need to override.

# --- api/api-donate (see api/.dev.vars.example, api-donate/.dev.vars.example) ---
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# APP_NAME=Virtue Initiative
# API_BASE_PATH=/api
# EMAIL_DELIVERY_MODE=log
# BUG_REPORT_EMAIL=help@virtueinitiative.org
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PUBLIC_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/...

# --- client/ Rust build-time defaults (see client/core/build.rs) ---
# VIRTUE_DEFAULT_API_URL=http://localhost:8787
# VIRTUE_DEFAULT_CAPTURE_INTERVAL_SECONDS=300
# VIRTUE_DEFAULT_BATCH_WINDOW_SECONDS=3600

# --- client/android dev scripts (see client/android/scripts/env.sh) ---
# ANDROID_SDK_ROOT=
# ANDROID_NDK_ROOT=
# VIRTUE_AVD=virtue_api35
# VIRTUE_PACKAGE=org.virtueinitiative.virtue
# VIRTUE_ACTIVITY=org.virtueinitiative.virtue/.MainActivity
